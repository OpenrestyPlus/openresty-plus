MYSQL_DATABASE=openresty-plus
MYSQL_USER=openresty-plus
MYSQL_PASSWORD=openresty-plus-local
MYSQL_ROOT_PASSWORD=openresty-plus-root
OPENRESTY_HTTP_ADDR=:8081
OPENRESTY_ADMIN_USERNAME=vben
# Set a unique password before starting the control plane.
OPENRESTY_ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32. Back up this key with database backups.
OPENRESTY_DATA_KEY=
# One-time migration source. These values are never used by the running stack.
MIGRATION_SOURCE_DB_URL=jdbc:mysql://192.168.100.6:3306/openresty-plus?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MIGRATION_SOURCE_DB_USERNAME=openresty-plus
MIGRATION_SOURCE_DB_PASSWORD=
OPENRESTY_OIDC_ISSUER=http://localhost:8081/realms/openresty-plus
OPENRESTY_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OPENRESTY_KAFKA_TOPIC=dtl-602-openresty-plus
OPENRESTY_KAFKA_CONSUMER_GROUP=openresty-plus-control-plane-v1
# Optional MaxMind GeoLite2/GeoIP2 City database for request origin maps.
# Provide a licensed database file path; keep the .mmdb file outside the repository.
OPENRESTY_GEOIP_DB_PATH=
# Control-plane import storage directory for GeoIP City databases (defaults to runtime/geoip).
OPENRESTY_GEOIP_STORAGE_DIR=runtime/geoip
# Optional control-plane node IDs; Filebeat node names provide fallback mapping.
FILEBEAT_EAST_1_NODE_ID=
FILEBEAT_EAST_2_NODE_ID=
FILEBEAT_EAST_3_NODE_ID=
