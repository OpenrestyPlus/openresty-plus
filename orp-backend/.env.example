# Compose services
MYSQL_DATABASE=openresty-plus
MYSQL_USER=openresty-plus
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

# Go control plane
OPENRESTY_HTTP_ADDR=:8081
# Optional dedicated node-Agent mTLS listener. Leave all four blank to disable it.
OPENRESTY_AGENT_HTTPS_ADDR=
OPENRESTY_AGENT_TLS_CERT_FILE=
OPENRESTY_AGENT_TLS_KEY_FILE=
OPENRESTY_AGENT_CLIENT_CA_FILE=
OPENRESTY_DB_URL=jdbc:mysql://127.0.0.1:3306/openresty-plus?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
OPENRESTY_DB_USERNAME=openresty-plus
OPENRESTY_DB_PASSWORD=change-this-local-password
OPENRESTY_ADMIN_USERNAME=vben
OPENRESTY_ADMIN_PASSWORD=change-this-before-starting
# Generate with: openssl rand -hex 32. Keep stable and back it up with the database.
OPENRESTY_DATA_KEY=
OPENRESTY_REDIS_ADDR=127.0.0.1:6379
OPENRESTY_REDIS_PASSWORD=
OPENRESTY_REDIS_DB=0
OPENRESTY_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OPENRESTY_KAFKA_TOPIC=dtl-602-openresty-plus
OPENRESTY_KAFKA_CONSUMER_GROUP=openresty-plus-control-plane-v1
OPENRESTY_GEOIP_DB_PATH=
OPENRESTY_GEOIP_STORAGE_DIR=runtime/geoip
FILEBEAT_EAST_1_NODE_ID=
FILEBEAT_EAST_2_NODE_ID=
FILEBEAT_EAST_3_NODE_ID=

# Optional one-time external database migration source. Never used by runtime services.
MIGRATION_SOURCE_DB_URL=jdbc:mysql://db.example.invalid:3306/openresty-plus?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MIGRATION_SOURCE_DB_USERNAME=
MIGRATION_SOURCE_DB_PASSWORD=
